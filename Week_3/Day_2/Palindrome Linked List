class Solution {
public:
    bool isPalindrome(ListNode* head) {
        
        vector<int> values;

        ListNode* temp = head;

        while(temp != nullptr) {
            values.push_back(temp->val);
            temp = temp->next;
        }

        int left = 0;
        int right = values.size() - 1;

        while(left < right) {
            if(values[left] != values[right]) {
                return false;
            }
            left++;
            right--;
        }

        return true;
    }
}; 