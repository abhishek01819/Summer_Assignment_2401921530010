class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        vector<int> result;
        int n = s.length();
        int m = p.length();
        
        if (n < m) return result;
        vector<int> p_count(26, 0);
        vector<int> window_count(26, 0);
        
        for (int i = 0; i < m; i++) {
            p_count[p[i] - 'a']++;
            window_count[s[i] - 'a']++;
        }
        bool first_match = true;
        
        for (int i = 0; i < 26; i++) {
            if (p_count[i] != window_count[i]) {
                first_match = false;
                break;
            }
        }
        if (first_match) result.push_back(0);
        
        for (int i = m; i < n; i++) {
            window_count[s[i] - 'a']++;
            window_count[s[i - m] - 'a']--;
            
            bool match = true;
            for (int c = 0; c < 26; c++) {
                if (p_count[c] != window_count[c]) {
                    match = false;
                    break;
                }
            }
            
            if (match) {
                result.push_back(i - m + 1);
            }
        }
        
        return result;
    }
};
