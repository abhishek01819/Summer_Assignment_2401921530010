class Solution {
public:
    int compress(vector<char>& chars) {
        int n = chars.size();
        int writeIndex = 0;
        int i = 0;

        while (i < n) {
            char currChar = chars[i];
            int count = 0;

            while (i < n && chars[i] == currChar) {
                count++;
                i++;
            }

            chars[writeIndex++] = currChar;

            if (count > 1) {
                string countStr = to_string(count);
                for (char digit : countStr) {
                    chars[writeIndex++] = digit;
                }
            }
        }

        return writeIndex;
    }
};
