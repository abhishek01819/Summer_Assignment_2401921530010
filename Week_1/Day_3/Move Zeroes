#include <vector>
using namespace std;

class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        
        int j = 0; // position for next non-zero element

        // step 1: move all non-zero elements forward
        for(int i = 0; i < nums.size(); i++) {
            if(nums[i] != 0) {
                nums[j] = nums[i];
                j++;
            }
        }

        // step 2: fill remaining with zero
        for(int i = j; i < nums.size(); i++) {
            nums[i] = 0;
        }
    }
};