#include <vector>
using namespace std;

class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        
        int n = nums.size();

        // first window sum
        int windowSum = 0;
        for(int i = 0; i < k; i++) {
            windowSum += nums[i];
        }

        int maxSum = windowSum;

        // sliding window
        for(int i = k; i < n; i++) {
            windowSum += nums[i];
            windowSum -= nums[i - k];

            if(windowSum > maxSum) {
                maxSum = windowSum;
            }
        }

        return (double)maxSum / k;
    }
};